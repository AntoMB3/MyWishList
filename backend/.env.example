# Ruta de la base de datos (SQLite local por defecto)
DATABASE_URL="sqlite:///./whishlist.db"

# Clave secreta para firmar los JWT (mínimo 32 caracteres, aleatoria en producción).
# Sin ella la aplicación no arranca: la clave de desarrollo es pública.
SECRET_KEY="cambia-esto-por-un-secreto-largo-y-aleatorio"

# Algoritmo de firma y duración del token (minutos)
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Límites de peticiones para endpoints sensibles (fuerza bruta y abuso de CPU)
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_REGISTER_PER_HOUR=5
RATE_LIMIT_MEDIA_PER_MINUTE=10
RATE_LIMIT_UNFURL_PER_MINUTE=10

# Swagger UI (/docs): oculto automáticamente al usar una SECRET_KEY real.
# Descomenta para habilitarlo también en desarrollo con clave propia.
# ENABLE_DOCS=1
