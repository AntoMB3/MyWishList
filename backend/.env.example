# Ruta de la base de datos (SQLite local por defecto)
DATABASE_URL="sqlite:///./whishlist.db"

# Clave secreta para firmar los JWT (mínimo 32 caracteres, aleatoria en producción)
SECRET_KEY="cambia-esto-por-un-secreto-largo-y-aleatorio"

# Algoritmo de firma y duración del token (minutos)
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
