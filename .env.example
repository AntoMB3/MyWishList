# Clave secreta para firmar tokens JWT (mínimo 32 caracteres).
# Puedes generar una segura con: openssl rand -hex 32
# OBLIGATORIA en producción: si no se define, la aplicación se niega a
# arrancar (evita firmar tokens con la clave pública de desarrollo).
SECRET_KEY=cambia-esta-clave-secreta-por-una-de-al-menos-32-caracteres

# URL de conexión a la base de datos:
# - Local por defecto: sqlite:///./whishlist.db
# - En Docker con volumen en /data: sqlite:////data/whishlist.db
# - PostgreSQL (Neon / Supabase): postgresql+psycopg://user:pass@host/dbname
DATABASE_URL=sqlite:////data/whishlist.db

# Carpeta donde se guardan las fotos subidas (WebP comprimido).
# En Docker debe vivir en el mismo volumen persistente que la base.
MEDIA_DIR=/data/media

# Tiempo de expiración del token JWT en minutos (por defecto 1440 = 24h)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Límites por usuario para proteger el servidor y la base de datos.
# El frontend los consulta en GET /api/config.
MAX_WISHLISTS_PER_USER=5
MAX_ITEMS_PER_WISHLIST=20

# Documentación interactiva (/docs). Por defecto queda habilitada solo en
# desarrollo (cuando SECRET_KEY es la de ejemplo) y oculta en producción.
# ENABLE_DOCS=1

# Límite de peticiones por minuto/hora para los endpoints sensibles
# (protección contra fuerza bruta y abuso de CPU/ancho de banda).
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_REGISTER_PER_HOUR=5
RATE_LIMIT_MEDIA_PER_MINUTE=10
RATE_LIMIT_UNFURL_PER_MINUTE=10

# Si despliegas detrás de un proxy inverso (Fly.io, Railway, Render, nginx…),
# indica aquí la IP del proxy para que uvicorn confíe en X-Forwarded-For y el
# limitador de tasa use la IP real del cliente. Usa * solo si el contenedor
# no es accesible directamente desde Internet.
# FORWARDED_ALLOW_IPS=*
