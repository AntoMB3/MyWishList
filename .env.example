# Clave secreta para firmar tokens JWT (mínimo 32 caracteres).
# Puedes generar una segura con: openssl rand -hex 32
SECRET_KEY=cambia-esta-clave-secreta-por-una-de-al-menos-32-caracteres

# URL de conexión a la base de datos:
# - Local por defecto: sqlite:///./whishlist.db
# - En Docker con volumen en /data: sqlite:////data/whishlist.db
# - PostgreSQL (Neon / Supabase): postgresql+psycopg://user:pass@host/dbname
DATABASE_URL=sqlite:////data/whishlist.db

# Carpeta donde se guardan las fotos subidas (WebP comprimido).
# En Docker debe vivir en el mismo volumen persistente que la base.
MEDIA_DIR=/data/media

# Tiempo de expiración del token JWT en minutos (por defecto 1440 = 24h)
ACCESS_TOKEN_EXPIRE_MINUTES=1440
